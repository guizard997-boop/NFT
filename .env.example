# Токен Telegram-бота, полученный у @BotFather
BOT_TOKEN=

# Ваш Telegram ID (администратор бота). Узнать можно у @userinfobot
ADMIN_ID=

# Ключ TonAPI (необязательно, но снимает лимиты на запросы)
# Получить: https://tonconsole.com
TONAPI_KEY=

# Адреса NFT-коллекций для мониторинга через запятую
NFT_COLLECTIONS=EQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,EQyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# Интервал опроса TonAPI, секунды (необязательно, по умолчанию 20)
POLL_INTERVAL=20

# Порт для health-check сервера (Railway/Render подставляют его сами через PORT)
PORT=8080
